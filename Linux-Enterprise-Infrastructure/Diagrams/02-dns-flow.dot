digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.45, ranksep=0.65, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#F7F9FC", color="#46637F", fontname="Arial", margin="0.18"];
  edge [color="#58738D", fontname="Arial", arrowsize=0.8];

  client [label="Linux Client\nresolver query"];
  bind [label="BIND on Server1\nAuthoritative + recursive"];
  zone [label="linuxlab.local zone\nInternal A records", fillcolor="#EEF9ED"];
  forwarder [label="AWS VPC DNS\n172.31.0.2", fillcolor="#FFF6DC"];
  internet [label="Public DNS / Internet", shape=ellipse, fillcolor="#E8F3FF"];

  client -> bind [label=" web1.linuxlab.local "];
  bind -> zone [label=" internal zone "];
  zone -> client [label=" 172.31.36.76 "];

  bind -> forwarder [label=" external query "];
  forwarder -> internet;
  internet -> forwarder [label=" answer "];
  forwarder -> bind;
}
